{
  "name": "ding",
  "version": "0.0.0",
  "private": true,
  "description": "Ding \u2014 Swiftee's WhatsApp-native omnichannel team inbox",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check:threading": "tsx tools/check-threading.ts",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @ding/api db:generate",
    "db:migrate": "pnpm --filter @ding/api db:migrate",
    "db:seed": "pnpm --filter @ding/api db:seed",
    "eas-build-post-install": "pnpm --filter \"@ding/client...\" build"
  },
  "devDependencies": {
    "pixelmatch": "^5.3.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
