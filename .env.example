# ---- API ----
API_PORT=3001
# Allowed browser origin for CORS + Socket.IO (the web app in dev)
CORS_ORIGIN=http://localhost:5173

# ---- Auth ----
# Secret used to sign session JWTs (change in every real environment).
AUTH_JWT_SECRET=ding-dev-secret-change-me
AUTH_COOKIE_NAME=ding_session
AUTH_TTL_SECONDS=604800
# Password given to all seeded demo users (dev only).
AUTH_DEV_PASSWORD=ding1234

# ---- Database (Postgres) ----
# The API runs on in-memory fixtures when DATABASE_URL is unset, so you can
# `pnpm dev` with zero infra. Set this (and run `pnpm db:up`) for the real path.
DATABASE_URL=postgresql://ding:ding@localhost:5432/ding?schema=public

# ---- Redis ----
# Optional. When set, the realtime gateway uses the Redis adapter so it can
# scale across multiple nodes. Unset = single-node in-memory (fine for dev).
REDIS_URL=redis://localhost:6379

# ---- WhatsApp (Cloud API) ----
# The API runs a MOCK WhatsApp provider until WHATSAPP_TOKEN + PHONE_NUMBER_ID
# are set, so the full send/receive loop is testable without a live number.
WHATSAPP_VERIFY_TOKEN=ding-dev-verify
# App secret → validates the X-Hub-Signature-256 on inbound webhooks (optional in dev).
WHATSAPP_APP_SECRET=
# Set these two to send for real via the Cloud API (otherwise messages are mocked).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ---- Email (Cloud) ----
# The API runs a MOCK email provider until POSTMARK_TOKEN is set.
POSTMARK_TOKEN=
EMAIL_FROM=support@swiftee.co.uk
EMAIL_DOMAIN=swiftee.co.uk
# Optional shared secret; when set, inbound email webhooks must pass ?token=.
EMAIL_INBOUND_TOKEN=

# ---- Google / Gmail (OAuth "Connect with Google") ----
# The app-level Google OAuth client id + secret are set in-product under
# Settings › Setup (stored per-org in AppSettings), NOT here. When this flag is
# true the whole consent flow is MOCKED — the popup completes end-to-end with
# fake tokens and a demo Gmail address, so it works with no real Google creds.
GOOGLE_OAUTH_MOCK=false
# Inbound Gmail polling cadence in seconds (0 disables polling → push-only).
GMAIL_POLL_SECONDS=60
# Optional shared secret; when set, the Pub/Sub push webhook must pass ?token=.
GMAIL_PUSH_TOKEN=

# ---- Web (Vite) ----
# In dev the web app proxies /api and /socket.io to the API, so this is only
# needed if you point the web build at a non-proxied API.
VITE_API_URL=
