# Metro (React Native's bundler) resolves modules by walking up node_modules
# directories and does not understand pnpm's symlinked store, so an Expo app in
# a pnpm workspace needs the flat, npm-style layout. This is Expo's documented
# requirement for pnpm monorepos, not a preference.
#
# The API and web app are unaffected — hoisted is the layout they'd get under
# npm or yarn anyway.
node-linker=hoisted
