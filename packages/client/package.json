{
  "name": "@ding/client",
  "version": "0.0.0",
  "private": true,
  "description": "Shared API transport, socket and react-query hooks for the web and native apps.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ding/schemas": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.62.7",
    "react": ">=18",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.7",
    "@types/react": "^18.3.17",
    "react": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "react-native": "./src/index.ts"
}
