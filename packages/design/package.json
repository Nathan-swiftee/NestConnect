{
  "name": "@ding/design",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design tokens and icon geometry for the web (Tailwind) and native (NativeWind) apps.",
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./tokens": "./tokens.ts",
    "./icons": "./icons.ts",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./logo": "./logo.ts"
  },
  "files": [
    "icons.ts",
    "logo.ts",
    "tailwind-preset.cjs",
    "tokens.css",
    "tokens.ts"
  ],
  "scripts": {
    "build": "node scripts/generate-tokens.mjs",
    "typecheck": "node scripts/generate-tokens.mjs --check",
    "check:icons": "node --experimental-strip-types scripts/check-icons.mjs"
  }
}
