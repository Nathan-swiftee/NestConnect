{
  "name": "@ding/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Nest Connect for iOS and Android (Expo / React Native).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo ios android",
    "web": "expo start --web"
  },
  "dependencies": {
    "@ding/client": "workspace:*",
    "@ding/design": "workspace:*",
    "@ding/schemas": "workspace:*",
    "@expo/metro-runtime": "~57.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "8.23.0",
    "@tanstack/react-query": "^5.62.7",
    "expo": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.13",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.12",
    "expo-linking": "~57.0.7",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
