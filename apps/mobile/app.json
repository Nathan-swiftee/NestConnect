{
  "expo": {
    "name": "Nest Connect",
    "slug": "nest-connect",
    "owner": "swiftee",
    "scheme": "nestconnect",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#FAFAF9",
    "updates": {
      "url": "https://u.expo.dev/4a369ffe-af17-43ee-8304-f3ddf47565a0",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "bundleIdentifier": "co.uk.swiftee.nestconnect",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "co.uk.swiftee.nestconnect",
      "adaptiveIcon": {
        "backgroundColor": "#0FA47A"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nest Connect uses your photos so you can send one to a customer.",
          "cameraPermission": "Nest Connect uses the camera so you can photograph something for a customer."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Nest Connect uses the microphone so you can reply with a voice note."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0FA47A",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "4a369ffe-af17-43ee-8304-f3ddf47565a0"
      }
    }
  }
}
