// Ding data model — the Postgres/Prisma schema behind the platform.
// Phase 0 runs on in-memory fixtures; this is the real persistence layer,
// ready for `prisma migrate`. Mirrors docs/04-data-model.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelType {
  whatsapp
  whatsapp_group
  email
  nestchat
}

enum ConversationStatus {
  open
  pending
  snoozed
  closed
}

enum MessageDirection {
  in
  out
}

enum MessageStatus {
  queued
  sending
  sent
  delivered
  read
  failed
}

enum AuthorType {
  contact
  user
  system
}

enum Priority {
  low
  normal
  high
  urgent
}

enum Role {
  admin
  manager
  agent
}

enum RoutingStrategy {
  manual
  round_robin
  load_balanced
  most_idle
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  region    String   @default("uk")
  createdAt DateTime @default(now())

  users         User[]
  teams         Team[]
  inboxes       Inbox[]
  contacts      Contact[]
  conversations Conversation[]
  labels        Label[]
  templates     Template[]
  auditLogs     AuditLog[]
  customFields  CustomField[]
}

/// A fact a workspace wants to record that we did not think of.
///
/// Defined once and used anywhere, rather than a column per idea: "order id" is
/// a food-delivery business's word for the thing a booking agency calls a
/// booking reference and an insurer calls a policy number. Adding a column for
/// each would mean shipping a migration every time somebody integrates
/// something, and a schema that reads as a list of our customers.
///
/// Org-level rather than channel-level, with an optional restriction to
/// particular channels: an order id belongs on the app's chats *and* on the
/// WhatsApp number the same customers message, and defining it twice would make
/// them two unrelated things to search.
model CustomField {
  id       String @id @default(cuid())
  orgId    String
  /// Stable machine name — what an SDK sends. Never changes once in use.
  key      String
  /// What an agent reads. Free to change; the key is the identity.
  label    String
  /// text | number | date | url | select
  type     String @default("text")
  /// contact | conversation. A contact's facts follow the person; a
  /// conversation's belong to one thread — which is which is the difference
  /// between "this customer's loyalty tier" and "the order this chat is about".
  entity   String
  /// The choices, for `select`. Empty for every other type.
  options  String[] @default([])
  /// Which channels offer it. Empty means all of them.
  inboxIds String[] @default([])
  /// Display order in the panel, low first.
  position Int     @default(0)
  /// Retired rather than deleted: the values already recorded against it are
  /// history, and deleting the definition would silently destroy them.
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  org    Organization       @relation(fields: [orgId], references: [id])
  values CustomFieldValue[]

  @@unique([orgId, key])
  @@index([orgId, entity, archived])
}

/// One field's value on one contact or one conversation.
///
/// A table rather than a JSON column on each row, and the reason is search. An
/// order number is looked up far more often than it is written — an agent has a
/// customer on the phone reading it out — and that has to be an index hit, not
/// a scan of every conversation's JSON.
model CustomFieldValue {
  id       String @id @default(cuid())
  /// Denormalised from the field, so a search can be scoped without a join.
  orgId    String
  fieldId  String
  entity   String
  entityId String
  /// As entered, for display.
  value    String
  /// Folded for matching: trimmed, lower-cased, and for the shapes people write
  /// reference numbers in, stripped of spaces and dashes. "dg 88412" finds
  /// "DG-88412", because the customer reading it out loud does not know which
  /// way it was typed.
  normalizedValue String

  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  /// One value per field per record.
  @@unique([fieldId, entity, entityId])
  /// The panel's read: every field on the record being opened.
  @@index([orgId, entity, entityId])
  /// The search: every record carrying this value.
  @@index([orgId, fieldId, normalizedValue])
  /// The same, when the field isn't known — a bare id typed into the search box.
  @@index([orgId, normalizedValue])
}

model User {
  id          String   @id @default(cuid())
  orgId       String
  name         String
  email        String
  role         Role     @default(agent)
  avatarColor  String?
  // Uploaded profile photo, served via /api/media/:id. Falls back to Gravatar,
  // then coloured initials, when null.
  avatarUrl    String?
  online       Boolean  @default(false)
  // Manual "accepting work" flag (distinct from `online` presence) — an
  // unavailable agent is skipped by round-robin auto-assignment.
  available    Boolean  @default(true)
  // Personal rich-text (HTML) email signature, appended to outbound email the
  // agent sends. Never shown on the in-app message bubble.
  emailSignature String?
  passwordHash String?
  // Emailed-invite flow: SHA-256 of a single-use token + its expiry. Cleared
  // once the invitee sets their password.
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  // Two-factor auth. `twoFactorEnabled` gates login; `twoFactorMethod` is
  // "totp" (authenticator app) or "email". `totpSecret` is the base32 secret,
  // encrypted at rest — present-but-not-enabled means enrolment is in progress.
  twoFactorEnabled Boolean @default(false)
  twoFactorMethod  String?
  totpSecret       String?
  // Emailed one-time code for the "email" method / enrolment: hash + expiry.
  twoFactorEmailCodeHash    String?
  twoFactorEmailCodeExpires DateTime?
  // Which push notifications this person wants, as JSON (see PushPreferences).
  // Null = the defaults: assigned-to-me, mentions, assignments and reminders on,
  // all-team-inbound off — the setting that otherwise makes people uninstall.
  pushPrefs                 String?
  createdAt    DateTime @default(now())

  org         Organization   @relation(fields: [orgId], references: [id])
  memberships TeamMember[]
  assigned    Conversation[] @relation("assignee")
  messages    Message[]
  notes       Note[]
  notifications Notification[]
  sessions    Session[]
  devices     Device[]
  recoveryCodes RecoveryCode[]

  @@unique([orgId, email])
  @@index([orgId])
}

// One-time backup codes for 2FA recovery (lost authenticator). Stored hashed;
// `usedAt` marks a spent code so it can't be replayed.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A signed-in device/browser. The session id rides in the JWT as its `jti`, so a
// revoked row (revokedAt set) invalidates that cookie on the next request —
// which is what powers "where you're signed in" + remote sign-out.
model Session {
  id         String    @id @default(cuid())
  userId     String
  // Captured at sign-in for the "where you're logged in" list.
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  // Set when the session is signed out (here or remotely); nulls = active.
  revokedAt  DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices Device[]

  @@index([userId])
}

// A phone (or tablet) that can receive push. Keyed by the push token, because
// that IS the address we send to — a reinstall produces a new token and so a new
// row, and the same token can never belong to two people at once.
//
// `sessionId` ties the device to the sign-in that registered it, so remote
// sign-out stops its notifications instead of leaving a signed-out phone still
// buzzing. `disabledAt` + `disabledReason` record a token the push service told
// us is dead (`DeviceNotRegistered`) or one whose owner revoked permission in OS
// settings — without it we'd push at a dead address forever.
model Device {
  id             String    @id @default(cuid())
  userId         String
  sessionId      String?
  // The Expo push token ("ExponentPushToken[...]"). Unique: one row per address.
  pushToken      String    @unique
  platform       String
  // App + OS build, for triaging "only broken on iOS 26" reports.
  appVersion     String?
  osVersion      String?
  deviceName     String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  disabledAt     DateTime?
  disabledReason String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

/// A per-user bell notification (a mention, a snooze coming due, …).
model Notification {
  id             String   @id @default(cuid())
  userId         String
  type           String
  title          String
  body           String   @default("")
  conversationId String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Team {
  id              String          @id @default(cuid())
  orgId           String
  name            String
  icon            String?
  order           Int             @default(0)
  slaMinutes      Int?
  routingStrategy RoutingStrategy @default(manual)

  org           Organization   @relation(fields: [orgId], references: [id])
  members       TeamMember[]
  inboxes       InboxTeam[]
  conversations Conversation[] @relation("assignedTeam")

  @@index([orgId])
}

model TeamMember {
  userId String
  teamId String
  role   String @default("member")

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@id([userId, teamId])
}

model Inbox {
  id              String          @id @default(cuid())
  orgId           String
  type            ChannelType
  name            String
  handle          String
  routingStrategy RoutingStrategy @default(manual)
  channelConfig   Json?
  // The number/address this channel sends from when a reply is switched onto it
  // from a thread that started somewhere else. Without one the oldest inbox of
  // the type wins, which is deterministic but arbitrary — this is how a
  // workspace with two numbers says which one it wants to be known by.
  //
  // At most one per (org, channel type), enforced by a partial unique index in
  // the migration rather than by the setter alone: it decides which number a
  // customer sees, and two rows claiming it would be a coin toss again.
  isDefault       Boolean         @default(false)
  createdAt       DateTime        @default(now())

  org           Organization   @relation(fields: [orgId], references: [id])
  teams         InboxTeam[]
  conversations Conversation[]

  @@index([orgId])
}

model InboxTeam {
  inboxId String
  teamId  String

  inbox Inbox @relation(fields: [inboxId], references: [id])
  team  Team  @relation(fields: [teamId], references: [id])

  @@id([inboxId, teamId])
}

model Contact {
  id          String   @id @default(cuid())
  orgId       String
  displayName String
  company     String?
  avatarColor String?
  tags        String[] @default([])
  ownerUserId String?
  ownerTeamId String?
  // Blocked: inbound messages from this contact are dropped and they're hidden
  // from the customer directory by default.
  blocked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  org           Organization      @relation(fields: [orgId], references: [id])
  identities    ContactIdentity[]
  conversations Conversation[]
  participations Participant[]

  @@index([orgId])
}

model ContactIdentity {
  id        String  @id @default(cuid())
  contactId String
  orgId     String? // denormalized from the contact, for per-org identity lookups
  kind      String // phone | email | wa_id
  value     String // as entered / received (kept for display)
  normalizedValue String? // canonical form for dedup: E.164 phone, lowercase email
  verified  Boolean @default(false)

  contact Contact @relation(fields: [contactId], references: [id])

  @@unique([kind, value])
  @@index([contactId])
  @@index([orgId, kind, normalizedValue])
}

model Conversation {
  id             String             @id @default(cuid())
  orgId          String
  inboxId        String
  contactId      String
  channel        ChannelType
  subject        String?
  inviteLink     String?
  channelRef     String?
  status         ConversationStatus @default(open)
  assigneeUserId String?
  assignedTeamId String?
  priority       Priority           @default(normal)
  unread         Boolean            @default(false)
  unreadCount    Int                @default(0)
  slaDueAt       DateTime?
  snoozedUntil   DateTime?
  lastActivityAt DateTime           @default(now())
  // Timestamp of the most recent inbound (customer) message — drives WhatsApp's
  // 24-hour customer-service window. Null until the customer first messages.
  lastInboundAt  DateTime?
  seq            Int                @default(0)
  preview        String             @default("")
  createdAt      DateTime           @default(now())

  org              Organization        @relation(fields: [orgId], references: [id])
  inbox            Inbox               @relation(fields: [inboxId], references: [id])
  contact          Contact             @relation(fields: [contactId], references: [id])
  assignee         User?               @relation("assignee", fields: [assigneeUserId], references: [id])
  team             Team?               @relation("assignedTeam", fields: [assignedTeamId], references: [id])
  messages         Message[]
  notes            Note[]
  labels           ConversationLabel[]
  participants     Participant[]
  assignmentEvents AssignmentEvent[]

  @@index([orgId, inboxId, status, lastActivityAt])
  @@index([orgId, assigneeUserId, status, lastActivityAt])
  @@index([channelRef])
}

model Participant {
  id             String   @id @default(cuid())
  conversationId String
  contactId      String
  role           String   @default("member")
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id])

  @@unique([conversationId, contactId])
  @@index([conversationId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  seq            Int
  direction      MessageDirection
  authorType     AuthorType
  authorUserId   String?
  authorName     String?
  body           String
  // The channel this specific message was sent/received on. Lets one open
  // conversation carry messages across channels (WhatsApp, email …). Null on
  // legacy rows → falls back to the conversation's channel.
  channel        ChannelType?
  // Which inbox this actually went out from — the WhatsApp number or mailbox the
  // customer saw it arrive from. Resolved at delivery, not at compose: a reply
  // sent on a channel the conversation didn't start on goes from that channel's
  // inbox, which needn't be the conversation's. Null on legacy rows and on
  // inbound → falls back to the conversation's inbox, which is right for every
  // message that never went cross-channel.
  inboxId        String?
  // Sanitized HTML body for rich email (rendered in a sandboxed iframe); the
  // plain `body` above stays the fallback + preview text.
  bodyHtml       String?
  status         MessageStatus    @default(sent)
  internal       Boolean          @default(false)
  channelMsgId   String?
  // text | image | video | audio | voice | document | sticker | location | contact
  messageType    String           @default("text")
  // Emoji reactions: [{ emoji, by: "contact" | "user" }] (≤1 per participant).
  reactions      Json?
  // Id of the message this one quotes/replies to (same conversation).
  quotedMsgId    String?
  // Passed on from elsewhere rather than written here: set when an agent forwards
  // a message, and when WhatsApp flags an inbound one as forwarded to us.
  forwarded      Boolean          @default(false)
  // ---- durable outbound delivery bookkeeping (out messages only) ----
  // How many provider send attempts have been made, and when the last one ran.
  attemptCount   Int              @default(0)
  lastAttemptAt  DateTime?
  // Last provider/transport error message + code (diagnostics; backend-only).
  providerError  String?
  providerErrorCode String?
  // Human-readable reason once the send has permanently failed (shown in the UI).
  failureReason  String?
  // Dedup key for the delivery job (also the BullMQ jobId) — prevents double sends.
  idempotencyKey String?
  // Channel-specific send hints needed to (re)deliver from the DB alone after a
  // restart: { template?: { name, language, params }, cc?, bcc? }.
  deliveryMeta   Json?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  author       User?        @relation(fields: [authorUserId], references: [id])
  attachments  Attachment[]
  // Per-recipient email open-tracking rows (one per To/Cc address on an
  // outbound email; each carries a unique tracking-pixel token).
  emailRecipients EmailRecipient[]

  @@index([conversationId, seq])
  // Backs inbound idempotency + delivery-status lookups (both hit channelMsgId).
  @@index([channelMsgId])
  // Dedup outbound sends by idempotency key.
  @@unique([idempotencyKey])
  // Restart recovery scans for still-in-flight outbound messages.
  @@index([direction, status])
}

model Attachment {
  id         String   @id @default(cuid())
  // Null while an upload is staged (not yet attached to a sent message).
  messageId  String?
  // Storage object key (R2/S3 key or local path).
  r2Key      String
  mime       String
  size       Int
  filename   String
  // image | video | audio | voice | document | sticker | file
  kind       String   @default("file")
  // Audio/video length in ms; image intrinsic size; voice waveform peaks (JSON).
  durationMs Int?
  width      Int?
  height     Int?
  waveform   String?
  createdAt  DateTime @default(now())

  message Message? @relation(fields: [messageId], references: [id])

  @@index([messageId])
}

/// One outbound-email recipient (To or Cc), tracked individually for read
/// receipts. Each recipient gets their own copy of the email carrying a unique
/// tracking-pixel token; a request for that pixel stamps `openedAt`. This is the
/// per-recipient model Front uses: you see who opened, not just that someone did.
model EmailRecipient {
  id        String    @id @default(cuid())
  messageId String
  // The recipient's email address (lower-cased).
  address   String
  // "to" | "cc" — where this address sat on the outbound email.
  kind      String    @default("to")
  // Unguessable token embedded in this recipient's tracking-pixel URL.
  token     String    @unique
  // When the tracking pixel was first requested (null until opened).
  openedAt  DateTime?
  // How many times the pixel has been requested (opens + re-opens/prefetches).
  openCount Int       @default(0)
  createdAt DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Note {
  id             String   @id @default(cuid())
  conversationId String
  authorUserId   String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  author       User         @relation(fields: [authorUserId], references: [id])
}

model Label {
  id    String @id @default(cuid())
  orgId String
  name  String
  color String

  org           Organization        @relation(fields: [orgId], references: [id])
  conversations ConversationLabel[]

  @@unique([orgId, name])
}

model ConversationLabel {
  conversationId String
  labelId        String

  conversation Conversation @relation(fields: [conversationId], references: [id])
  label        Label        @relation(fields: [labelId], references: [id])

  @@id([conversationId, labelId])
}

model AssignmentEvent {
  id             String   @id @default(cuid())
  conversationId String
  fromUserId     String?
  toUserId       String?
  toTeamId       String?
  byUserId       String?
  reason         String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

model Template {
  id             String @id @default(cuid())
  orgId          String
  name           String
  category       String // marketing | utility | authentication
  language       String @default("en")
  body           String
  approvalStatus String @default("pending")

  /// What each {{1}}, {{2}} … starts out as when somebody sends this.
  ///
  /// Index-aligned with the body's variables, and free text with {{token}}
  /// placeholders in it (see TEMPLATE_TOKENS) so "Hi from {{agent.name}}",
  /// plain "Order update" and a bare "{{contact.name}}" are all one kind of
  /// thing. Pre-filled, never forced: the fill form still opens and an agent
  /// can change any of it before sending.
  variableDefaults String[] @default([])

  /// The WhatsApp Business Account this template lives on.
  ///
  /// Templates belong to a WABA, not to a phone number: every number under one
  /// WABA can send all of its templates, and no number can send another WABA's.
  /// Without this column a workspace with two accounts shows one merged list,
  /// and roughly half of it fails at Meta with "template name does not exist"
  /// depending on which number the agent happened to be sending from.
  ///
  /// Null means "not claimed by any account yet" — a locally authored template,
  /// or one written before this column existed. Those show for every account
  /// until a sync tells us whose they are, because hiding a template everywhere
  /// is worse than showing it in one place too many.
  wabaId         String?

  org Organization @relation(fields: [orgId], references: [id])

  /// Two accounts may each have their own "order_update" in English, and they
  /// are different templates. Postgres treats NULLs as distinct here, so
  /// unclaimed rows never block a synced one from being inserted.
  ///
  /// That same NULL handling would also let two *unclaimed* rows share a name,
  /// which the old workspace-wide key prevented. A partial unique index in the
  /// migration keeps that guarantee for rows belonging to no account; Prisma
  /// has no syntax for a partial index, so it lives in SQL only and this
  /// comment is the pointer to it.
  @@unique([orgId, wabaId, name, language])
}

model RoutingRule {
  id         String          @id @default(cuid())
  inboxId    String?
  teamId     String?
  strategy   RoutingStrategy @default(manual)
  conditions Json?
  priority   Int             @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  actor     String
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
}

// Org-scoped app-level settings (e.g. the Google OAuth app client id/secret set
// in Settings › Setup). A plain key/value store keyed by (orgId, key).
model AppSetting {
  orgId String
  key   String
  value String

  @@id([orgId, key])
}

// Diagnostics for inbound webhooks that could not be handled deterministically —
// e.g. an event for a phone number/address we don't manage, or a bad signature.
// Deliberately org-less: these are recorded before (or because) tenant
// resolution failed, so they must not be pinned to an arbitrary org.
model WebhookDiagnostic {
  id        String   @id @default(cuid())
  channel   String // whatsapp | whatsapp_group | email | gmail
  kind      String // unmapped_inbox | bad_signature | unmapped_group
  reference String? // phone number id / email address / group id
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
